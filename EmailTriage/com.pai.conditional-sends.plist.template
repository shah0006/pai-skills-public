<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pai.conditional-sends</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{BUN_PATH}}</string>
        <string>run</string>
        <string>{{SKILL_ROOT}}/Tools/ConditionalSends.ts</string>
        <string>check</string>
    </array>
    <!-- Fires hourly to check conditional follow-ups. The replyChecker queries
         apple-mail.sh search; entries whose recipient replied get cancelled,
         entries with no reply past their follow-up date get fired via SendLater. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>15</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>{{SKILL_ROOT}}/tmp/conditional-sends.log</string>
    <key>StandardErrorPath</key>
    <string>{{SKILL_ROOT}}/tmp/conditional-sends.err</string>
    <key>WorkingDirectory</key>
    <string>{{SKILL_ROOT}}</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
