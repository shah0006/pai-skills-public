<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pai.reconciler</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BUN_BIN__</string>
        <string>run</string>
        <string>__SKILL_DIR__/Tools/Reconciler.ts</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/reconciler.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/reconciler.log</string>
</dict>
</plist>
